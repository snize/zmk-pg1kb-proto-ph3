#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &pg1kb_proto_physical_layout;
    };

    splits {
        #address-cells = <1>;
        #size-cells = <0>;

        left_trackball_input: left_trackball_input@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    left_trackball_listener: left_trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&left_trackball_input>;
    };

    right_trackball_listener: right_trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball>;
    };

    /*
     * scroll-inertia は split peripheral ではコンパイルできない central 専用プロセッサ。
     * ただし keymap は左右共通で読むため、左手ビルドでも &scroll_inertia_* のラベル自体は
     * 解決できる必要がある。ここでは disabled で共有定義し、右手 overlay だけで okay にする。
     *
     * axis = <0> は両軸フリー。現在の zip_xy_to_scroll_mapper は縦横同時の 2D スクロールを
     * 流すため、軸ロックはかけない。
     *
     * 左ボール Base は専用スクロールレイヤーではなく listener のデフォルトチェーンなので、
     * layer は省略して -1 相当とする。このため Base でフリック直後に Sym へ切り替えると、
     * 慣性は gesture-timeout / 自然減衰 / span で止まるまで流れ続ける。
     *
     * stop は README の式「出力頻度(Hz) ≒ stop * scale * 125 / scale-div」から、
     * スムーススクロール時の 16 単位 = 1 ノッチ換算で切れ際が約 3.9 ノッチ/s に揃う値。
     * デフォルト stop = 7 では 1/2 チェーンで約 13.7 ノッチ/s になり、手前で止まりすぎる。
     *
     * 発動条件（start / move / min-events）はデフォルトだと強めに弾かないと慣性が
     * 乗らなかったので下げている。3 ノードとも zip_xy_to_scroll_mapper の直後で
     * スケール前の生の値を見るため、しきい値は共通で問題ない。
     *   start      40 →  25  ピーク速度のしきい値（弾く強さ）
     *   move       80 →  50  ジェスチャー内の累積移動量（振り幅）
     *   min-events 10 →   6  アームに必要なイベント数。125Hz なので 10 だと 80ms 以上
     *                        ボールを回し続ける必要があり、短いフリックが弾かれていた
     * 逆に軽く触っただけで慣性が乗るようなら、この 3 つを戻す方向に上げる。
     */
    scroll_inertia_left_base: scroll_inertia_left_base {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        status = "disabled";
        axis = <0>;
        scale = <1>;
        scale-div = <2>;
        stop = <2>;
        start = <25>;
        move = <50>;
        min-events = <6>;
    };

    scroll_inertia_left_sym: scroll_inertia_left_sym {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        status = "disabled";
        axis = <0>;
        layer = <2>;
        scale = <1>;
        scale-div = <6>;
        stop = <3>;
        start = <25>;
        move = <50>;
        min-events = <6>;
    };

    scroll_inertia_right_sym: scroll_inertia_right_sym {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        status = "disabled";
        axis = <0>;
        layer = <2>;
        scale = <1>;
        scale-div = <2>;
        stop = <2>;
        start = <25>;
        move = <50>;
        min-events = <6>;
    };

    /*
     * DYA Studio からカーソル感度を変えるための runtime input processor。
     *
     * scroll_inertia と同じ流儀で、ここでは status = "disabled" の共有定義だけを置き、
     * pg1kb_proto_right.overlay でのみ okay にする。左手ビルドでは listener 自体が
     * disabled なのでインスタンス化されない（このドライバも DT_INST_FOREACH_STATUS_OKAY）。
     *
     * 既存の zip_xy_scaler の後段に置き、初期値は 1/1 倍。つまり書き込み直後の操作感は
     * 従来と変わらず、Web から掛けた倍率が「そのボールのカーソル感度」として上乗せされる。
     * 減速したときの情報損失を減らすため、固定スケーラで拡大した後に置いている
     * （余りは track-remainders で繰り越される）。
     *
     * 右ボールは Base と Num で同じノードを共有する。Web 上は「右ボールの感度」という
     * 1 つのつまみになり、レイヤー間の 3/2 : 1/2 という比率は devicetree 側で保たれる。
     *
     * processor-label は BLE 互換のため 8 文字までという制限がある。
     */
    rip_left_cursor: rip_left_cursor {
        compatible = "zmk,input-processor-runtime";
        status = "disabled";
        processor-label = "L-Ball";
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <1>;
        track-remainders;
        #input-processor-cells = <0>;
    };

    rip_right_cursor: rip_right_cursor {
        compatible = "zmk,input-processor-runtime";
        status = "disabled";
        processor-label = "R-Ball";
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <1>;
        track-remainders;
        #input-processor-cells = <0>;
    };

    pg1kb_proto_physical_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default 5x12 Split Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   75       0     0     0>
            , <&key_physical_attrs 100 100  100   75       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  500   25       0     0     0>
            , <&key_physical_attrs 100 100  650   25       0     0     0>
            , <&key_physical_attrs 100 100  750    0       0     0     0>
            , <&key_physical_attrs 100 100 1050   75       0     0     0>
            , <&key_physical_attrs 100 100 1150   75       0     0     0>
            , <&key_physical_attrs 100 100    0  175       0     0     0>
            , <&key_physical_attrs 100 100  100  175       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  100       0     0     0>
            , <&key_physical_attrs 100 100  500  125       0     0     0>
            , <&key_physical_attrs 100 100  650  125       0     0     0>
            , <&key_physical_attrs 100 100  750  100       0     0     0>
            , <&key_physical_attrs 100 100  850  100       0     0     0>
            , <&key_physical_attrs 100 100  950  100       0     0     0>
            , <&key_physical_attrs 100 100 1050  175       0     0     0>
            , <&key_physical_attrs 100 100 1150  175       0     0     0>
            , <&key_physical_attrs 100 100    0  275       0     0     0>
            , <&key_physical_attrs 100 100  100  275       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  200       0     0     0>
            , <&key_physical_attrs 100 100  500  225       0     0     0>
            , <&key_physical_attrs 100 100  650  225       0     0     0>
            , <&key_physical_attrs 100 100  750  200       0     0     0>
            , <&key_physical_attrs 100 100  850  200       0     0     0>
            , <&key_physical_attrs 100 100  950  200       0     0     0>
            , <&key_physical_attrs 100 100 1050  275       0     0     0>
            , <&key_physical_attrs 100 100 1150  275       0     0     0>
            , <&key_physical_attrs 100 100    0  375       0     0     0>
            , <&key_physical_attrs 100 100  100  375       0     0     0>
            , <&key_physical_attrs 100 100  200  300       0     0     0>
            , <&key_physical_attrs 100 100  300  300       0     0     0>
            , <&key_physical_attrs 100 100  400  300       0     0     0>
            , <&key_physical_attrs 100 100  500  325       0     0     0>
            , <&key_physical_attrs 100 100  650  325       0     0     0>
            , <&key_physical_attrs 100 100  750  300       0     0     0>
            , <&key_physical_attrs 100 100  850  300       0     0     0>
            , <&key_physical_attrs 100 100  950  300       0     0     0>
            , <&key_physical_attrs 100 100 1050  375       0     0     0>
            , <&key_physical_attrs 100 100 1150  375       0     0     0>
            , <&key_physical_attrs 100 100  200  400       0     0     0>
            , <&key_physical_attrs 100 100  300  400       0     0     0>
            , <&key_physical_attrs 100 100  400  400       0     0     0>
            , <&key_physical_attrs 100 100  500  425       0     0     0>
            , <&key_physical_attrs 100 100  650  425       0     0     0>
            , <&key_physical_attrs 100 100  750  400       0     0     0>
            , <&key_physical_attrs 100 100  850  400       0     0     0>
            , <&key_physical_attrs 100 100  950  400       0     0     0>
            ;
    };

    /*
     * DYA Studio のプレビューに左右のボールを描くための定義。
     * 座標と大きさは上の physical layout の keys と同じ単位（100 = 1u）。
     * 実機を DYA Studio に繋いだプレビューを見ながら調整する前提の暫定値。
     *
     * linked-* は index を揃えた必須プロパティで、そのボールがどの Custom Studio
     * Protocol のデバイスに対応するかを Studio へ伝える。この機体のセンサーは
     * PAW3222 で専用の RPC を持たないため、感度を持っている runtime input
     * processor（サブシステム識別子 cormoran_rip、デバイス識別子は processor-label）
     * を指している。
     */
    pg1kb_proto_left_ball: pg1kb_proto_left_ball {
        compatible = "cormoran,physical-layout-trackball";
        display-name = "Left Ball";
        size = <120>;
        x = <100>;
        y = <475>;
        linked-device-identifiers = "L-Ball";
        linked-subsystems = "cormoran_rip";
    };

    pg1kb_proto_right_ball: pg1kb_proto_right_ball {
        compatible = "cormoran,physical-layout-trackball";
        display-name = "Right Ball";
        size = <120>;
        x = <1050>;
        y = <475>;
        linked-device-identifiers = "R-Ball";
        linked-subsystems = "cormoran_rip";
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
            RC(1,5) RC(1,4)                 RC(0,1) RC(0,0)         RC(0,6) RC(0,7)                 RC(1,10) RC(1,11)
            RC(2,5) RC(2,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)         RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(2,10) RC(2,11)
            RC(3,5) RC(3,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)         RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(3,10) RC(3,11)
            RC(4,5) RC(4,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)         RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(4,10) RC(4,11)
                            RC(4,3) RC(4,2) RC(4,1) RC(4,0)         RC(4,6) RC(4,7) RC(4,8) RC(4,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
    };
};

&spi0 {
    trackball: trackball@0 {
        status = "disabled";
        reg = <0>;
        spi-max-frequency = <2000000>;
    };
};
